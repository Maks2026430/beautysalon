# ─── Postgres (used by the db service) ───────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=beauty_salon

# ─── Database / cache ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@db:5432/beauty_salon
REDIS_URL=redis://redis:6379/0

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_64_char_string________________________
JWT_ACCESS_TTL=900        # 15 min
JWT_REFRESH_TTL=2592000   # 30 days

# Refresh-токен в httpOnly-cookie. На проде за HTTPS поставьте COOKIE_SECURE=true,
# иначе браузер не сохранит cookie и вход «слетает» после обновления токена.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── OpenAI API (или совместимый шлюз, напр. ProxyAPI) ───────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Пусто = официальный OpenAI. Для ProxyAPI: https://api.proxyapi.ru/openai/v1
OPENAI_BASE_URL=

# ─── SMS (smsc.ru) ───────────────────────────────────────────────────
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=BeautySalon

# ─── Payment (YooKassa) ──────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=beauty-salon

# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.ru/api
FRONTEND_URL=https://yourdomain.ru

# ─── OTP (client phone login) ────────────────────────────────────────
OTP_TTL=300        # seconds the code stays valid
OTP_LENGTH=4

# ─── Initial admin (created by seed.py if missing) ───────────────────
ADMIN_EMAIL=admin@lumiere-salon.ru
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Администратор
